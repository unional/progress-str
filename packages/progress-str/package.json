{
	"name": "progress-str",
	"version": "3.4.4",
	"description": "Create a progress string",
	"homepage": "https://github.com/cyberuni/progress-str",
	"bugs": {
		"url": "https://github.com/cyberuni/progress-str/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/progress-str.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"type": "module",
	"exports": {
		"types": "./esm/index.d.ts",
		"import": "./esm/index.js",
		"require": "./cjs/index.js",
		"default": "./cjs/index.js"
	},
	"main": "./cjs/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.spec.*"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf .reports cjs coverage esm",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "pnpm clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all -p build depcheck typecheck coverage",
		"watch": "vitest"
	},
	"dependencies": {
		"left-pad": "^1.3.0",
		"make-error": "^1.3.5",
		"right-pad": "^1.0.1",
		"string-length": "^7.0.0",
		"type-plus": "^7.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"assertron": "^11.0.0",
		"chalk": "^6.0.0",
		"depcheck": "^1.4.3",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">= 20"
	}
}
