{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"newLine": "LF",
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		// Load-bearing: assertron pulls in iso-error, whose .d.ts uses private
		// identifiers, which fail under this target. Checking dependency declarations
		// gains nothing here.
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		// TypeScript 7 no longer pulls every @types/* package into the global scope on
		// its own, so the ambient ones this package relies on are named here.
		// vitest/globals supplies `test` and `expect`, matching `globals: true`.
		"types": ["node", "vitest/globals"]
	},
	"include": ["ts", "tsdown.config.ts", "vitest.config.ts"]
}
